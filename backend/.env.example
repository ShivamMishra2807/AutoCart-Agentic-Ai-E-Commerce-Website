# ==============================================================================
# AutoCart Backend Environment Configuration Template
# ==============================================================================

DEBUG=False
SECRET_KEY=generate_a_random_secure_django_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app
DATABASE_URL=
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com

# AI Keys (Groq / Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT=5
AUTOCART_DISABLE_EMBEDDINGS=0

# Email (Optional)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
