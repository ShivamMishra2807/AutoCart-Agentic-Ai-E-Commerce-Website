# ==============================================================================
# AutoCart Environment Configuration Template
# Copy this file to .env and configure keys appropriate for your local setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# AutoCart LangChain & Multi-Agent AI (Backend Only - Never expose to client bundles)
# Supports Groq Cloud (Llama 3.3 / Mixtral) and Google Gemini (gemini-2.5-flash / gemini-1.5-flash)
# Automatic failover: checks Groq first, then Gemini, then grounded local fallback.
# ------------------------------------------------------------------------------

# Option A: Groq Cloud (Free Tier at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini (Free Tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=15

# General LLM Bounded Timeout (in seconds)
LLM_TIMEOUT=5

# Optional: Local HuggingFace Text Embeddings (fastembed BAAI/bge-small-en-v1.5)
# Set to 1 to disable fastembed download and use fast keyword retrieval
AUTOCART_DISABLE_EMBEDDINGS=0

# ------------------------------------------------------------------------------
# Email Service Configuration (Optional)
# Without these settings, password reset and notification emails print to the console.
# ------------------------------------------------------------------------------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
