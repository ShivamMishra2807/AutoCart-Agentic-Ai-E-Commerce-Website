# ==============================================================================
# AutoCart Production & Local Environment Configuration Template
# Copy this file to .env and configure keys appropriate for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment (Vercel / Vite)
# ------------------------------------------------------------------------------
# In production on Vercel, set this to your deployed Render backend API URL (e.g., https://autocart-backend.onrender.com/api)
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# Django Backend Core Settings (Render)
# ------------------------------------------------------------------------------
# Set DEBUG to False in production
DEBUG=False

# A secure random secret key (Render can auto-generate this)
SECRET_KEY=generate_a_random_secure_django_secret_key

# Comma-separated list of allowed hostnames (e.g., your-backend.onrender.com,localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.vercel.app

# Managed PostgreSQL connection string (provided automatically by Render Postgres or Supabase/Neon)
# Example: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=

# CORS & CSRF allowed origins (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com

# ------------------------------------------------------------------------------
# AutoCart LangChain & Multi-Agent AI (Backend Only - Never expose to client bundles)
# Supports Groq Cloud (Llama 3.3 / Mixtral) and Google Gemini (gemini-2.5-flash / gemini-1.5-flash)
# Automatic failover: checks Groq first, then Gemini, then grounded local fallback.
# ------------------------------------------------------------------------------

# Option A: Groq Cloud (Free Tier at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini (Free Tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=15

# General LLM Bounded Timeout (in seconds)
LLM_TIMEOUT=5

# Optional: Local HuggingFace Text Embeddings (fastembed BAAI/bge-small-en-v1.5)
# Set to 1 if you wish to disable fastembed model download and use fast keyword search
AUTOCART_DISABLE_EMBEDDINGS=0

# ------------------------------------------------------------------------------
# Email Service Configuration (Optional)
# Without these settings, password reset and notification emails print to the console.
# ------------------------------------------------------------------------------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
